{
  "platform": {
    "apiRuntime": "node:22"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "routes": [
    {
      "route": "/",
      "redirect": "/taskpane.html",
      "statusCode": 302
    },
    {
      "route": "/sso-redirect.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/sharepoint/*",
      "headers": {
        "Access-Control-Allow-Origin": "https://rocktwpnet.sharepoint.com"
      }
    },
    {
      "route": "/downloads/dork-dashboard.sppkg",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Disposition": "attachment; filename=\"dork-dashboard.sppkg\""
      }
    },
    {
      "route": "/downloads/*.sppkg",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Disposition": "attachment; filename=\"geek-launcher.sppkg\""
      }
    }
  ]
}
